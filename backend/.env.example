FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///watchshop.db
CORS_ORIGINS=http://localhost:5173

# Single admin (plain password for local dev; use strong value in prod)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password

# JWT for admin session (minutes)
ADMIN_JWT_EXPIRES_MIN=4320

# OTP SMS: set MSG91_AUTHKEY + MSG91_TEMPLATE_ID + MSG91_SENDER_ID for MSG91
# Or leave unset — OTP is logged to server console in dev
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Razorpay (test keys from dashboard)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications after order (optional)
ADMIN_PHONE=
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public URL of API (for Razorpay callbacks / links in emails)
PUBLIC_API_BASE=http://localhost:5000
